---
// One Post. Its text sits above the artwork, laid out like the home page.
import PageTitle from '../../components/PageTitle.astro';
import PostArt from '../../components/PostArt.astro';
import Layout from '../../layouts/Layout.astro';
import { loadPosts } from '../../posts/load-posts.ts';

export function getStaticPaths() {
	return loadPosts().map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
---

<Layout title="Post · Expresión Catártica">
	<PageTitle text="Expresiones" />
	<main class="flex flex-1 flex-col p-2">
		<p class="max-h-40 overflow-y-auto border-b-2 border-base-content/20 px-3 py-2 text-center text-3xl whitespace-pre-wrap">{post.writing}</p>
		<PostArt post={post} class="relative grow" />
	</main>
	<a href="/posts" class="btn btn-sm fixed top-2 left-2 z-20">← posts</a>
</Layout>
