---
// Home page
import PageTitle from '../components/PageTitle.astro';
import SaveIcon from '../components/SaveIcon.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<PageTitle text="Expresión Catártica" />

	<main class="group flex flex-1 flex-col p-2">
		<!-- <div class="flex w-full flex-wrap items-center justify-center gap-2">
			<label for="canvas-preset">Canvas size</label>
			<select id="canvas-preset" class="select">
				<option value="square">Square (1:1)</option>
				<option value="portrait">Portrait (4:5)</option>
				<option value="story">Story (9:16)</option>
				<option value="custom">Custom</option>
			</select>
			<input id="canvas-width" class="input w-20" type="number" placeholder="Width" min="1" hidden />
			<input id="canvas-height" class="input w-20" type="number" placeholder="Height" min="1" hidden />
		</div> -->

		<!-- <div class="flex gap-2">
			<button id="generate" class="btn">Generate</button>
			<button id="export-jpg" class="btn">Export JPG</button>
			<button id="export-svg" class="btn">Export SVG</button>
		</div> -->

		<div class="relative">
			<textarea id="writing" class="textarea field-sizing-content max-h-40 w-full resize-none rounded-none border-0 border-b-2 bg-transparent pr-14 focus:outline-hidden text-center text-3xl" rows="1" placeholder="Write here..."></textarea>
			<button id="save" class="btn btn-outline btn-square absolute top-1/2 right-0 -translate-y-1/2" aria-label="Save" disabled>
				<SaveIcon />
			</button>
		</div>
		<dialog id="save-modal" class="modal">
			<form id="save-form" class="modal-box flex flex-col gap-4">
				<label for="secret-phrase">Secret phrase</label>
				<input id="secret-phrase" type="password" class="input w-full" autocomplete="off" required />
				<div class="flex items-center justify-between gap-2">
					<p id="save-result" role="status" class="text-sm"></p>
					<button class="btn btn-square shrink-0" aria-label="Save">
						<SaveIcon />
					</button>
				</div>
			</form>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>
		<div id="canvas-container" class="relative grow overflow-hidden opacity-0 transition-opacity duration-200 group-data-art:opacity-100 group-data-art:duration-4000 [&_canvas]:absolute [&_canvas]:inset-0 [&_canvas]:h-full! [&_canvas]:w-full! [&_canvas]:object-cover"></div>
	</main>

	<script src="../widget/widget.ts"></script>
</Layout>
